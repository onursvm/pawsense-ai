# PawSense AI Frontend Environment Variables
# In production, set this to your deployed FastAPI backend URL:
# Example: VITE_API_BASE_URL=https://pawsense-backend.onrender.com
# In local development, leave blank to use the local Vite proxy or default to http://127.0.0.1:8000
VITE_API_BASE_URL=http://127.0.0.1:8000
